# ---------------------------------------------------------------------------
# IO Digital Ecosystem — Laravel API environment template
# Copy to .env and fill in values. NEVER commit .env or real secrets.
# ---------------------------------------------------------------------------

APP_NAME="Ifeanyi Osiaku"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:3100
# APP_URL is the PUBLIC origin (the Next.js site proxies /api and /admin to Laravel),
# so generated links and signed URLs match what the browser sees. Laravel itself listens on 127.0.0.1:8110.
# Public website (Next.js). Used for links in emails and redirects.
FRONTEND_URL=http://localhost:3100

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# Default display time zone for users who have not chosen one
APP_DISPLAY_TIMEZONE=Africa/Lagos

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ifeanyiosiaku
DB_USERNAME=root
DB_PASSWORD=

# Sessions: database locally, redis in production. Cookies are HttpOnly + SameSite=Lax;
# SESSION_SECURE_COOKIE must be true anywhere HTTPS is used (staging/production).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Origins allowed to make cross-origin requests (CORS). Normally only the website itself.
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# Staff two-factor requirement before /admin. Leave unset to use the default:
# OFF when APP_ENV is local/testing, ON when APP_ENV=production. Super Administrators can also change it
# in Admin > Site settings.
# REQUIRE_STAFF_TWO_FACTOR=true

# Comma-separated list of proxy IPs whose X-Forwarded-* headers are trusted ("*" only behind a private network).
TRUSTED_PROXIES=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=io_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development writes emails to storage/logs. Configure a real provider in staging/production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ifeanyiosiaku.online"
MAIL_FROM_NAME="${APP_NAME}"

# CAPTCHA: first_party (default) | recaptcha | turnstile | null (testing only)
CAPTCHA_DRIVER=first_party
# First-party proof-of-work difficulty in leading zero bits (higher = slower to solve)
CAPTCHA_DIFFICULTY=16
CAPTCHA_TTL_SECONDS=300
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Shared secret Laravel uses to ask Next.js to refresh cached pages after publishing.
WEB_REVALIDATE_SECRET=

# Object storage (production). Leave empty locally.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Payment providers (Milestone 3) — leave empty until sandbox keys are issued.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
