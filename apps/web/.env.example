# Website (Next.js) environment template. Copy to .env.local for development.
# Laravel API origin used by the proxy rewrites. Read at BUILD time.
API_INTERNAL_URL=http://127.0.0.1:8110
# Public site URL used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
# Same value as WEB_REVALIDATE_SECRET in apps/api/.env (lets Laravel refresh cached pages on publish).
WEB_REVALIDATE_SECRET=
